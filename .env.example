# Database (Neon Cloud PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth Configuration
# NEXTAUTH_URL: Your production URL (e.g., https://buildsync.vercel.app)
NEXTAUTH_URL="https://your-app.vercel.app"

# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl"

# Host split — marketing on the apex, the authenticated app on its own host.
# Inert unless BOTH are set; see the block comment in src/proxy.ts.
# APP_HOST="app.ttcivilstructural.com"
# PUBLIC_HOST="ttcivilstructural.com"

# Resend Email Service
RESEND_API_KEY=
EMAIL_FROM=BuildSync <onboarding@resend.dev>

# Application URL
APP_URL=http://localhost:3000

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Anthropic AI
ANTHROPIC_API_KEY=

# Load Generator uses 100% free services — no API keys required:
#   • Map tiles: CartoDB Dark Matter (OpenStreetMap) — no signup, no key
#   • Geocoding: Nominatim (OSM) — no key, polite User-Agent
#   • Elevation: Open-Elevation — no key, best-effort
# If those services are rate-limiting you at scale, swap them for paid
# equivalents (Google Maps, MapTiler, Mapbox) in:
#   - src/components/ttc/load-gen/SiteMap.tsx
#   - src/app/api/load-gen/geocode/route.ts
#   - src/app/api/load-gen/elevation/route.ts

# Which workspace owns the public contact-form inbox (ContactSubmission is a
# GLOBAL table, so "who may read the leads" needs an explicit answer).
# Only OWNER/ADMIN of THIS workspace can read /portal/admin/submissions.
# Unset = fall back to the oldest workspace that still has an OWNER/ADMIN,
# which logs a warning. Pin it in production. See src/lib/contact-inbox.ts.
CONTACT_INBOX_WORKSPACE_ID=

# Which workspace is "the" workspace for a user who belongs to several.
# Most accounts hold two memberships: the singleton created at signup and the
# firm workspace they were invited to. Without this, the app picks the first
# membership with more than one member, which for a user who belongs to two
# multi-member workspaces is simply whichever they joined first — not
# necessarily the firm's. Set it to the firm workspace id (the same value as
# CONTACT_INBOX_WORKSPACE_ID) and the guesswork disappears.
PRIMARY_WORKSPACE_ID=
